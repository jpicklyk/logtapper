{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // No global jsxImportSource: every src-solid/**/*.tsx carries its own
    // /** @jsxImportSource solid-js */ pragma. src-shared/ has no JSX at all.
    "jsx": "preserve",
    "baseUrl": ".",
    // Mirrors `solid.aliases.ts`, which vite.config.ts and vitest.config.ts
    // share. `src-solid/aliases.test.ts` asserts the two
    // stay in sync. Bare entries exist for the barrel-only modules (imported
    // as `from '@workspace'`); Vite resolves those through the same directory
    // alias.
    "paths": {
      "@bridge/*": ["src-shared/bridge/*"],
      "@viewport/*": ["src-shared/viewport/*"],
      "@cache/*": ["src-shared/cache/*"],
      "@filter/*": ["src-shared/filter/*"],
      "@bench": ["src-shared/bench/index.ts"],
      "@bench/*": ["src-shared/bench/*"],
      "@workspace": ["src-shared/workspace/index.ts"],
      "@workspace/*": ["src-shared/workspace/*"],
      "@pipeline": ["src-shared/pipeline/index.ts"],
      "@pipeline/*": ["src-shared/pipeline/*"],
      "@fileinfo": ["src-shared/fileinfo/index.ts"],
      "@fileinfo/*": ["src-shared/fileinfo/*"],
      "@processors": ["src-shared/processors/index.ts"],
      "@processors/*": ["src-shared/processors/*"],
      "@analysis": ["src-shared/analysis/index.ts"],
      "@analysis/*": ["src-shared/analysis/*"],
      "@timeline": ["src-shared/timeline/index.ts"],
      "@timeline/*": ["src-shared/timeline/*"],
      "@viewer": ["src-shared/viewer/index.ts"],
      "@viewer/*": ["src-shared/viewer/*"],
      "@bookmarks": ["src-shared/bookmarks/index.ts"],
      "@bookmarks/*": ["src-shared/bookmarks/*"]
    }
  },
  "include": ["src-solid", "src-shared"]
}
