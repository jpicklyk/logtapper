{
  "name": "log-tapper",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.solid.config.ts",
    "build": "tsc -p tsconfig.solid.json --noEmit && vite build --config vite.solid.config.ts",
    "test": "vitest run --config vitest.solid.config.ts",
    "test:watch": "vitest --config vitest.solid.config.ts",
    "preview": "vite preview --config vite.solid.config.ts",
    "dev:solid": "npm run dev",
    "build:solid": "npm run build",
    "test:solid": "npm run test",
    "dev:react": "vite",
    "build:react": "tsc && vite build",
    "test:react": "vitest run",
    "tauri:react": "tauri dev --config src-tauri/tauri.react.conf.json",
    "tauri:react:build": "tauri build --config src-tauri/tauri.react.conf.json",
    "build:mcp-sidecar": "bun install --cwd mcp-server && npm --prefix mcp-server run build:binary",
    "build:full": "npm run build && npm run build:mcp-sidecar && npm run build:mcpb",
    "tauri": "tauri",
    "lint": "eslint src-next/ src-solid/",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:all": "npm run lint && npm run lint:rust && npm run check:types",
    "gen:types": "cargo test --manifest-path src-tauri/Cargo.toml --test export_bindings",
    "check:types": "npm run gen:types && git diff --exit-code -- src-next/bridge/generated && tsc --noEmit && tsc -p tsconfig.solid.json --noEmit",
    "build:mcpb": "npm --prefix mcp-server run build:mcpb"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/geist": "^5.2.8",
    "@tanstack/react-virtual": "^3.10.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "mitt": "^3.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "solid-js": "1.9.15",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^9.39.4",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@solidjs/testing-library": "0.8.10",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "3.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-solid": "0.18.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.0.18"
  }
}
