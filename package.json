{
  "name": "log-tapper",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "dev:solid": "npm run dev",
    "build:solid": "npm run build",
    "test:solid": "npm run test",
    "build:mcp-sidecar": "bun install --cwd mcp-server && npm --prefix mcp-server run build:binary",
    "build:full": "npm run build && npm run build:mcp-sidecar && npm run build:mcpb",
    "tauri": "tauri",
    "lint": "eslint src-shared/ src-solid/",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:all": "npm run lint && npm run lint:rust && npm run check:types",
    "gen:types": "cargo test --manifest-path src-tauri/Cargo.toml --test export_bindings",
    "check:types": "npm run gen:types && git diff --exit-code -- src-shared/bridge/generated && tsc --noEmit",
    "build:mcpb": "npm --prefix mcp-server run build:mcpb",
    "version:check": "node scripts/bump-version.mjs --check",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@fontsource/geist": "^5.2.8",
    "@tauri-apps/api": "~2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "clsx": "^2.1.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "solid-js": "1.9.15",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^9.39.4",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@solidjs/testing-library": "0.8.10",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/dom": "^10.4.1",
    "@types/hast": "3.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-solid": "0.18.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.0.18"
  }
}
