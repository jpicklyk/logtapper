{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LogTapper",
  "version": "0.11.0",
  "identifier": "io.github.jpicklyk.logtapper",
  "build": {
    "frontendDist": "../dist-solid",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run build:mcpb && npm run dev:solid",
    "beforeBuildCommand": "npm run build:solid && npm run build:mcpb"
  },
  "app": {
    "windows": [
      {
        "title": "LogTapper",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420 http://localhost:1421",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../marketplace/marketplace.json": "marketplace/marketplace.json",
      "../mcp-server/dist/logtapper.mcpb": "mcp/logtapper.mcpb"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "lts"
        ],
        "name": "LogTapper Session",
        "description": "LogTapper session file",
        "role": "Editor"
      },
      {
        "ext": [
          "ltw"
        ],
        "name": "LogTapper Workspace",
        "description": "LogTapper workspace file",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
